---
import Section from "../../ui/Section.astro";
import Container from "../../ui/Container.astro";
import SectionHeader from "../../ui/SectionHeader.astro";

const differences = [
  {
    title: "Прямой ввоз из ЕС и США",
    description: "Организуем прямую поставку, если маршрут, товар и документы позволяют это официально.",
    color: "bg-emerald-500",
  },
  {
    title: "Казахстанский коридор",
    description: "Выстраиваем поставку через Казахстан и сопровождаем сделку на всём маршруте.",
    color: "bg-blue-500",
  },
  {
    title: "Минимум действий с вашей стороны",
    description: "Собираем документы и координируем участников, оставляя вам только необходимые действия.",
    color: "bg-purple-500",
  },
  {
    title: "Стоимость фиксируется заранее",
    description: "Заранее согласуем состав работ, фиксируем стоимость и отдельно обсуждаем изменения.",
    color: "bg-orange-500",
  },
];

const euFlags = [
  "at", "be", "bg", "hr", "cy", "cz", "dk",
  "ee", "fi", "fr", "de", "gr", "hu",
  "ie", "it", "lv", "lt", "lu", "mt", "nl",
  "pl", "pt", "ro", "sk", "si", "es", "se",
];

const flagUrl = (code: string) => `https://flagcdn.io/flags/4x3/${code}.svg`;
const networkFlags = [...euFlags, "us"];
---

<Section id="differences" border="sides-top">
  <Container>
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-stretch lg:gap-20" data-differences>
      <div>
        <SectionHeader heading="h2">
          <Fragment slot="title">
            Когда важна не просто перевозка, <strong class="text-accent font-semibold">а понятная сделка.</strong>
          </Fragment>
        </SectionHeader>

        <div class="mt-6 md:mt-12">
          {differences.map((difference, index) => (
            <button
              type="button"
              class="group relative flex w-full cursor-pointer items-start gap-4 py-5 pl-5 text-left transition-colors md:gap-6 md:py-4 md:pl-4"
              data-difference-trigger
              data-difference-index={index}
              data-active={index === 0 ? "true" : "false"}
              aria-pressed={index === 0}
              aria-controls={`difference-description-${index}`}
            >
              <span class="absolute inset-y-0 left-0 w-0.5 bg-border" aria-hidden="true">
                <span
                  class="absolute inset-x-0 top-0 bg-emerald-500"
                  data-difference-progress
                  style={`height: ${index === 0 ? "100%" : "0%"}`}
                ></span>
              </span>

              <span class="min-w-0">
                <h3 class="block text-ui-lg text-text-secondary transition-colors group-hover:text-text-primary group-data-[active=true]:text-text-primary" data-difference-title>
                  {difference.title}
                </h3>
                <p
                  id={`difference-description-${index}`}
                  class="mt-2 block max-w-120 text-body text-text-secondary text-balance"
                  data-difference-description
                  hidden={index !== 0}
                >
                  {difference.description}
                </p>
              </span>
            </button>
          ))}
        </div>
      </div>

      <div class="relative h-full min-h-80 w-full overflow-hidden rounded-xl border border-border bg-surface-card p-4 md:p-6 lg:min-h-0" aria-live="polite" aria-label="Визуализация выбранного отличия" data-difference-visuals>
        <div class="dot-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
        {differences.map((difference, index) => (
          <div
            class="absolute inset-0 z-10 flex items-center justify-center p-8"
            data-difference-visual
            data-difference-visual-index={index}
            hidden={index !== 0}
            aria-hidden={index !== 0}
          >
            {index === 0 ? (
              <div class="relative h-full w-full" data-difference-network>
                <svg class="pointer-events-none absolute inset-0 h-full w-full" data-difference-network-lines viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true">
                  <g fill="none" stroke="var(--color-border)" stroke-dasharray="4 8" stroke-linecap="round" stroke-width="1">
                    {networkFlags.map((flag) => <line data-difference-network-line={flag} />)}
                  </g>
                </svg>

                {networkFlags.map((flag) => (
                  <div
                    class="absolute h-6 w-6 -translate-x-1/2 -translate-y-1/2 overflow-hidden rounded-md border-1 border-border bg-surface-card md:h-8 md:w-8"
                    data-difference-network-node={flag}
                  >
                    <img src={flagUrl(flag)} alt="" class="h-full w-full object-cover" loading="lazy" />
                  </div>
                ))}

                <div class="absolute left-1/2 top-1/2 flex h-24 w-24 -translate-x-1/2 -translate-y-1/2 items-center justify-center overflow-hidden rounded-xl border-1 border-border bg-surface-card md:h-28 md:w-28" data-difference-network-center>
                  <img src={flagUrl("ru")} alt="" class="h-full w-full object-cover" loading="lazy" />
                </div>
              </div>
            ) : (
              <div class:list={["aspect-square w-1/2 max-w-80 rounded-[20px]", difference.color]}></div>
            )}
          </div>
        ))}
      </div>
    </div>
  </Container>
</Section>

<script>
  const section = document.querySelector<HTMLElement>("[data-differences]");

  if (section) {
    const triggers = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-difference-trigger]"));
    const visuals = Array.from(section.querySelectorAll<HTMLElement>("[data-difference-visual]"));
    let activeIndex = 0;

    const setActive = (nextIndex: number) => {
      activeIndex = nextIndex;

      triggers.forEach((trigger, index) => {
        const isActive = index === activeIndex;
        const description = trigger.querySelector<HTMLElement>("[data-difference-description]");
        const progress = trigger.querySelector<HTMLElement>("[data-difference-progress]");

        trigger.dataset.active = String(isActive);
        trigger.setAttribute("aria-pressed", String(isActive));
        if (description) description.hidden = !isActive;
        if (progress) progress.style.height = isActive ? "100%" : "0%";
      });

      visuals.forEach((visual, index) => {
        const isActive = index === activeIndex;
        visual.hidden = !isActive;
        visual.setAttribute("aria-hidden", String(!isActive));
      });
    };

    triggers.forEach((trigger, index) => {
      trigger.addEventListener("click", () => setActive(index));
    });

    const network = section.querySelector<HTMLElement>("[data-difference-network]");
    const networkLines = network?.querySelector<SVGSVGElement>("[data-difference-network-lines]");
    const networkCenter = network?.querySelector<HTMLElement>("[data-difference-network-center]");
    const networkNodes = Array.from(network?.querySelectorAll<HTMLElement>("[data-difference-network-node]") ?? []);
    const networkRoutes = Array.from(network?.querySelectorAll<SVGLineElement>("[data-difference-network-line]") ?? []);

    if (network && networkLines && networkCenter) {
      const updateNetwork = () => {
        const networkRect = network.getBoundingClientRect();
        const nodeSize = networkNodes[0]?.getBoundingClientRect().width ?? 28;
        const centerX = networkRect.width / 2;
        const centerY = networkRect.height / 2;
        const radiusX = Math.max(0, centerX - nodeSize / 2 - 12);
        const radiusY = Math.max(0, centerY - nodeSize / 2 - 12);

        networkLines.setAttribute("viewBox", `0 0 ${networkRect.width} ${networkRect.height}`);

        networkNodes.forEach((node, index) => {
          const angle = -Math.PI / 2 + (index / networkNodes.length) * Math.PI * 2;
          const x = centerX + Math.cos(angle) * radiusX;
          const y = centerY + Math.sin(angle) * radiusY;
          const route = networkRoutes[index];

          node.style.left = `${x}px`;
          node.style.top = `${y}px`;

          if (route) {
            route.setAttribute("x1", String(centerX));
            route.setAttribute("y1", String(centerY));
            route.setAttribute("x2", String(x));
            route.setAttribute("y2", String(y));
          }
        });
      };

      const resizeObserver = new ResizeObserver(updateNetwork);
      resizeObserver.observe(network);
      resizeObserver.observe(networkCenter);
      networkNodes.forEach((node) => resizeObserver.observe(node));
      updateNetwork();
    }
  }
</script>
